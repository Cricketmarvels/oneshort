{
  "expo": {
    "name": "PlayR",
    "slug": "playr",
    "owner": "playrrs-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.playr.cricket",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PlayR uses your approximate location to rank players and find matches, teams and communities near you. Your exact location is never shared.",
        "NSCameraUsageDescription": "Take a profile photo.",
        "NSPhotoLibraryUsageDescription": "Choose a profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171A1B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.playr.cricket",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F0",
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0D1716"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PlayR uses your approximate location to rank players and find matches, teams and communities near you. Your exact location is never shared."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo.",
          "cameraPermission": "Take a profile photo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#008C86",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PlayR uses the microphone only while you search by voice. Audio isn't recorded or stored.",
          "speechRecognitionPermission": "PlayR turns what you say into search text, e.g. 'I want to play on Saturday morning'.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "scheme": "playr",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8000/api/v1",
      "eas": {
        "projectId": "e8df9e32-92c4-4c6b-9234-f594c0389eb8"
      }
    }
  }
}
