# ---- Core
APP_ENV=development            # development | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- MongoDB (must be a replica set: transactions are required)
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DB=cricket_platform

# ---- Auth (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-dev-only-secret-change-me-dev-only
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- OTP provider: console (dev only; returns code in API response) | msg91 | twilio
OTP_PROVIDER=console
# Set false when exposing a dev server publicly: the console adapter then never reveals codes.
DEV_OTP_IN_RESPONSE=true
# Demo/staging only: brand-new numbers with this fictional prefix show their code on screen.
# Refused at startup in beta and production.
# TESTER_SIGNUP_PREFIX=+447700900
# Deferred features, off by default (see docs/AUTHENTICATION.md):
EMAIL_OTP_ENABLED=false        # email codes for sign-up/reset; this release verifies the phone only
INVITE_REGISTER_ENABLED=false  # legacy invite-link sign-up without an SMS code
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Ground search (GET /venues). Captains search a ground by the name on the gate, so GoFindr's own
# venues are merged with suggestions from a map provider; a suggestion is stored only when picked.
# osm = Photon/OpenStreetMap: free, no key, no account, but misses small Indian grounds.
# ola = Ola Maps: built for India, free key, no card, 100k events/month free. Needs PLACES_API_KEY.
# google = Places API (New): best coverage, but needs a Google Cloud project with billing and is
# charged per request. none = our venues only. See docs/GROUND_SEARCH_SETUP.md.
PLACES_PROVIDER=osm
PLACES_API_KEY=
PLACES_COUNTRY=in
PLACES_CACHE_HOURS=24

# WhatsApp: OTP login, match invitations and notifications (opt-in per user).
# none = send nothing. twilio = Twilio WhatsApp. meta = WhatsApp Cloud API.
# simulator = DEVELOPMENT: store messages and show them in the app's WhatsApp simulator (refused in production).
WHATSAPP_PROVIDER=none
# Needed to view another number's simulated inbox before login (simulator mode only)
WHATSAPP_SIMULATOR_KEY=
# Twilio: reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_OTP_SID=
TWILIO_CONTENT_NOTIFY_SID=
TWILIO_CONTENT_INVITE_SID=
# Meta Cloud API
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_OTP_TEMPLATE=
WHATSAPP_META_NOTIFY_TEMPLATE=
WHATSAPP_META_TEMPLATE=
WHATSAPP_META_LANGUAGE=en
WHATSAPP_META_API_VERSION=v25.0
# Only for scripts.whatsapp_meta_setup (creating/listing templates)
WHATSAPP_META_WABA_ID=
# Public URL of the GoFindr app, used in message links
APP_BASE_URL=

# ---- Storage: local | cloudinary
STORAGE_PROVIDER=local
CLOUDINARY_URL=

# ---- Push: none | fcm
PUSH_PROVIDER=none
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ---- Optional AI moderation triage (advisory only). Leave empty to disable.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Ranking weights (normalised at runtime)
RANK_W_PROXIMITY=0.25
RANK_W_AVAILABILITY=0.20
RANK_W_ROLE=0.15
RANK_W_RATING=0.12
RANK_W_RELIABILITY=0.13
RANK_W_PARTICIPATION=0.08
RANK_W_RESPONSE_RATE=0.07

SCHEDULER_ENABLED=true

# --- CricHeroes team data ---
# Only "disabled" is supported: CricHeroes has no public API and its terms prohibit scraping.
# Teams link their CricHeroes page and import data manually. See docs/INTEGRATIONS_CRICHEROES.md.
CRICHEROES_SOURCE=disabled
